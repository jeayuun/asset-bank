# Copy to .env.local and fill in real values. .env.local is git-ignored and
# is never read aloud, logged, or committed. See docs/DECISIONS.md D-13 for
# why this list is exactly this long and no longer.

# Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server only — never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Tooling only — a developer's machine and CI. Never set in Vercel.
SUPABASE_DB_URL=
